  </diagram>
  <diagram id="pg-pullups" name="5 - Pull-up Resistors (old: MAX30102 only — not needed now)">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1110" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5-1" value="&lt;b style=&#x27;font-size:22px&#x27;&gt;I²C pull-up resistors — two 10 kΩ side by side&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:14px&#x27;&gt;Your kit has no 4.7 kΩ. Two 10 kΩ &lt;b&gt;side by side&lt;/b&gt; (in parallel) act as one &lt;b&gt;5 kΩ&lt;/b&gt; resistor, which does the same job. You need &lt;b&gt;4 resistors&lt;/b&gt;: 2 on SDA and 2 on SCL.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=2;" vertex="1" parent="1"><mxGeometry x="40.0" y="24.0" width="1620.0" height="74.0" as="geometry" /></mxCell>
        <mxCell id="p5-2" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7fbff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40.0" y="120.0" width="780.0" height="640.0" as="geometry" /></mxCell>
        <mxCell id="p5-3" value="&lt;b&gt;① Circuit view — what “side by side” means&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;spacing=2;" vertex="1" parent="1"><mxGeometry x="60.0" y="132.0" width="740.0" height="28.0" as="geometry" /></mxCell>
        <mxCell id="p5-4" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#E07B00;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100.0" y="225.0" as="sourcePoint" /><mxPoint x="770.0" y="225.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-5" value="&lt;b style='color:#E07B00'&gt;3.3 V&lt;/b&gt; &amp;nbsp;— ESP32 &lt;b&gt;3.3V&lt;/b&gt; pin (the same rail that feeds MAX30102 VIN)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="100.0" y="188.0" width="660.0" height="32.0" as="geometry" /></mxCell>
        <mxCell id="p5-6" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="213.0" y="225.0" as="sourcePoint" /><mxPoint x="213.0" y="290.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="195.0" y="290.0" width="36.0" height="100.0" as="geometry" /></mxCell>
        <mxCell id="p5-8" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="213.0" y="390.0" as="sourcePoint" /><mxPoint x="213.0" y="455.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-9" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="207.0" y="219.0" width="12.0" height="12.0" as="geometry" /></mxCell>
        <mxCell id="p5-10" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="207.0" y="449.0" width="12.0" height="12.0" as="geometry" /></mxCell>
        <mxCell id="p5-11" value="&lt;b&gt;10 kΩ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="133.0" y="322.0" width="58.0" height="36.0" as="geometry" /></mxCell>
        <mxCell id="p5-12" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="313.0" y="225.0" as="sourcePoint" /><mxPoint x="313.0" y="290.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-13" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="295.0" y="290.0" width="36.0" height="100.0" as="geometry" /></mxCell>
        <mxCell id="p5-14" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="313.0" y="390.0" as="sourcePoint" /><mxPoint x="313.0" y="455.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-15" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="307.0" y="219.0" width="12.0" height="12.0" as="geometry" /></mxCell>
        <mxCell id="p5-16" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="307.0" y="449.0" width="12.0" height="12.0" as="geometry" /></mxCell>
        <mxCell id="p5-17" value="&lt;b&gt;10 kΩ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="335.0" y="322.0" width="58.0" height="36.0" as="geometry" /></mxCell>
        <mxCell id="p5-18" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#1F6FD0;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="455.0" as="sourcePoint" /><mxPoint x="410.0" y="455.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-19" value="&lt;b style='color:#1F6FD0'&gt;SDA&lt;/b&gt; — ESP32 pin 8, MAX30102 SDA&lt;br&gt;together: 10 ∥ 10 = &lt;b&gt;5 kΩ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="110.0" y="468.0" width="300.0" height="62.0" as="geometry" /></mxCell>
        <mxCell id="p5-20" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="573.0" y="225.0" as="sourcePoint" /><mxPoint x="573.0" y="290.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-21" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="555.0" y="290.0" width="36.0" height="100.0" as="geometry" /></mxCell>
        <mxCell id="p5-22" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="573.0" y="390.0" as="sourcePoint" /><mxPoint x="573.0" y="455.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-23" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="567.0" y="219.0" width="12.0" height="12.0" as="geometry" /></mxCell>
        <mxCell id="p5-24" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="567.0" y="449.0" width="12.0" height="12.0" as="geometry" /></mxCell>
        <mxCell id="p5-25" value="&lt;b&gt;10 kΩ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="493.0" y="322.0" width="58.0" height="36.0" as="geometry" /></mxCell>
        <mxCell id="p5-26" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="673.0" y="225.0" as="sourcePoint" /><mxPoint x="673.0" y="290.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-27" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="655.0" y="290.0" width="36.0" height="100.0" as="geometry" /></mxCell>
        <mxCell id="p5-28" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="673.0" y="390.0" as="sourcePoint" /><mxPoint x="673.0" y="455.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-29" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="667.0" y="219.0" width="12.0" height="12.0" as="geometry" /></mxCell>
        <mxCell id="p5-30" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="667.0" y="449.0" width="12.0" height="12.0" as="geometry" /></mxCell>
        <mxCell id="p5-31" value="&lt;b&gt;10 kΩ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="695.0" y="322.0" width="58.0" height="36.0" as="geometry" /></mxCell>
        <mxCell id="p5-32" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#2E8B2E;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470.0" y="455.0" as="sourcePoint" /><mxPoint x="770.0" y="455.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-33" value="&lt;b style='color:#2E8B2E'&gt;SCL&lt;/b&gt; — ESP32 pin 9, MAX30102 SCL&lt;br&gt;together: 10 ∥ 10 = &lt;b&gt;5 kΩ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="470.0" y="468.0" width="300.0" height="62.0" as="geometry" /></mxCell>
        <mxCell id="p5-34" value="&lt;b&gt;Side by side (in parallel)&lt;/b&gt; = both resistors connect to the &lt;b&gt;same two points&lt;/b&gt;: one leg of each on &lt;b&gt;3.3 V&lt;/b&gt;, the other leg of each on the &lt;b&gt;signal line&lt;/b&gt;. Current can go through either one, so together they behave like one &lt;b&gt;5 kΩ&lt;/b&gt; resistor — practically the same as the 4.7 kΩ in the original plan." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="60.0" y="538.0" width="740.0" height="84.0" as="geometry" /></mxCell>
        <mxCell id="p5-35" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4f4;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60.0" y="632.0" width="360.0" height="114.0" as="geometry" /></mxCell>
        <mxCell id="p5-36" value="&lt;b style=&#x27;color:#b85450&#x27;&gt;✗ Not end to end (in series)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;10 kΩ + 10 kΩ = 20 kΩ — too weak to help&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="72.0" y="638.0" width="340.0" height="40.0" as="geometry" /></mxCell>
        <mxCell id="p5-37" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95.0" y="712.0" as="sourcePoint" /><mxPoint x="140.0" y="712.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-38" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="140.0" y="700.0" width="70.0" height="24.0" as="geometry" /></mxCell>
        <mxCell id="p5-39" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210.0" y="712.0" as="sourcePoint" /><mxPoint x="240.0" y="712.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-40" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="240.0" y="700.0" width="70.0" height="24.0" as="geometry" /></mxCell>
        <mxCell id="p5-41" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310.0" y="712.0" as="sourcePoint" /><mxPoint x="355.0" y="712.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-42" value="3.3 V" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="70.0" y="724.0" width="70.0" height="20.0" as="geometry" /></mxCell>
        <mxCell id="p5-43" value="SDA" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="325.0" y="724.0" width="70.0" height="20.0" as="geometry" /></mxCell>
        <mxCell id="p5-44" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4f4;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="440.0" y="632.0" width="360.0" height="114.0" as="geometry" /></mxCell>
        <mxCell id="p5-45" value="&lt;b style=&#x27;color:#b85450&#x27;&gt;✗ Never to 5 V&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;The top end goes to &lt;b&gt;3.3 V&lt;/b&gt; only. 5 V here would push 5 V into ESP32 pins 8 and 9.&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#b85450&#x27;&gt;✗ Never from SDA to SCL&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Each pair joins its own signal line to 3.3 V — never the two lines to each other.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="452.0" y="638.0" width="340.0" height="104.0" as="geometry" /></mxCell>
        <mxCell id="p5-46" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fbfbf7;strokeColor=#9e9e9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="860.0" y="120.0" width="800.0" height="640.0" as="geometry" /></mxCell>
        <mxCell id="p5-47" value="&lt;b&gt;② On your breadboard&lt;/b&gt; (example at the MAX30102 pins)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;spacing=2;" vertex="1" parent="1"><mxGeometry x="880.0" y="132.0" width="760.0" height="28.0" as="geometry" /></mxCell>
        <mxCell id="p5-48" value="The holes next to ESP32 pins 8 and 9 are usually already full, so put the resistors in free holes of the &lt;b&gt;MAX30102&#x27;s SDA and SCL columns&lt;/b&gt;. Any free hole in a column that is wired to SDA (or SCL) works the same." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="880.0" y="162.0" width="760.0" height="40.0" as="geometry" /></mxCell>
        <mxCell id="p5-49" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f1f1ea;strokeColor=#bdbdbd;" vertex="1" parent="1"><mxGeometry x="1035.0" y="300.0" width="510.0" height="310.0" as="geometry" /></mxCell>
        <mxCell id="p5-50" value="f" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;spacing=2;fontColor=#8a8a8a;" vertex="1" parent="1"><mxGeometry x="1038.0" y="311.0" width="16.0" height="18.0" as="geometry" /></mxCell>
