<mxfile host="app.diagrams.net" agent="Claude" pages="7">
  <diagram id="pg-ad8232" name="0 - AD8232 ECG + OLED Wiring (current)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t0" value="&lt;b style=&#x27;font-size:22px&#x27;&gt;SereniSuit — Demo 1: AD8232 ECG + OLED (current wiring)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;Chest electrodes → heart beats (R-peaks) → BPM on the OLED, the website and the phone app → outside 60–100 = DANGER + vibration&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#555555&#x27;&gt;The MAX30102 and its pull-up resistors are gone; the AD8232 takes GPIO5/6/7 and the OLED keeps GPIO8/GPIO9. The DRV8833 + vibration motor part is unchanged. Page 0b is the hole-by-hole breadboard version; pages 1, 2, 4 and 5 are the old MAX30102 layout.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="90" as="geometry" /></mxCell>
        <mxCell id="esp" value="&lt;b&gt;ESP32-S3-DevKitC-1-N8R8&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;everything below is on the J1 header&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="360" height="870" as="geometry" /></mxCell>
        <mxCell id="esp_note" value="&lt;span style=&#x27;font-size:11px&#x27;&gt;&lt;b&gt;Power&lt;/b&gt;&lt;br&gt;USB-C ← power bank (demo)&lt;br&gt;or laptop (flashing only)&lt;br&gt;&lt;br&gt;&lt;b&gt;Breadboard rails&lt;/b&gt; (as before)&lt;br&gt;+ rail = 3.3 V from J1-1&lt;br&gt;− rail = GND&lt;br&gt;&lt;br&gt;The I²C bus (GPIO8/9) now carries the &lt;b&gt;OLED only&lt;/b&gt; — the MAX30102 is gone, and with it the pull-up resistors.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="220" height="320" as="geometry" /></mxCell>
        <mxCell id="e33a" value="3V3 · J1-1 (+ rail)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="220" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="e33b" value="3V3 · + rail" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="e5" value="GPIO5 · J1-5" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="e6" value="GPIO6 · J1-6" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="370" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="e7" value="GPIO7 · J1-7" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="420" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="eg1" value="G · − rail" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="470" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="eg3" value="G · − rail" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="620" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="e33c" value="3V3 · + rail" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="670" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="e9" value="GPIO9 · J1-15" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="720" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="e8" value="GPIO8 · J1-12" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="770" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="e4" value="GPIO4 · J1-4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="870" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="e5v" value="5V · J1-21" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="920" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="eg2" value="G · J1-22" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="970" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="ad" value="&lt;b&gt;AD8232 single-lead ECG module&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;heart-rate front end · 3.3 V only&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="360" height="420" as="geometry" /></mxCell>
        <mxCell id="a33" value="3.3V" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="220" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="asdn" value="SDN" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="270" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="aout" value="OUTPUT" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="320" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="alop" value="LO+" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="370" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="alom" value="LO−" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="agnd" value="GND" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="470" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="ad_note" value="&lt;span style=&#x27;font-size:11px&#x27;&gt;&lt;b&gt;3.3V&lt;/b&gt; — supply, never 5 V&lt;br&gt;&lt;b&gt;SDN&lt;/b&gt; — LOW = shut down, so tie it HIGH&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt; — analog ECG, sits near 1.5 V&lt;br&gt;&lt;b&gt;LO+ / LO−&lt;/b&gt; — go HIGH when an electrode is off&lt;br&gt;&lt;b&gt;GND&lt;/b&gt; — common ground with the ESP32 and DRV8833&lt;br&gt;&lt;br&gt;No resistors needed: the outputs are driven, and the firmware turns on the ESP32&#x27;s own pull-ups on GPIO6/7.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="870" y="205" width="240" height="290" as="geometry" /></mxCell>
        <mxCell id="jack" value="&lt;b&gt;3.5 mm jack&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;RA · LA · RL&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="500" width="110" height="44" as="geometry" /></mxCell>
        <mxCell id="w1" value="3.3 V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#b85450;endArrow=none;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e33a" target="a33"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w2" value="3.3 V → SDN (tie HIGH)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#b85450;endArrow=none;endFill=1;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e33b" target="asdn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w3" value="analog ECG" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#2d7d2d;endArrow=block;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aout" target="e5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w4" value="leads-off +" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#d79b00;endArrow=block;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alop" target="e6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w5" value="leads-off −" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#9673a6;endArrow=block;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alom" target="e7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w6" value="GND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#333333;endArrow=none;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eg1" target="agnd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oled" value="&lt;b&gt;SSD1306 OLED 0.96&quot;&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;I²C address 0x3C (a few boards: 0x3D)&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="760" y="590" width="360" height="230" as="geometry" /></mxCell>
        <mxCell id="ognd" value="GND" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="620" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="ovcc" value="VCC" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="670" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="oscl" value="SCL" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="720" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="osda" value="SDA" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="770" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="oled_note" value="&lt;span style=&#x27;font-size:11px&#x27;&gt;3.3–5 V tolerant — feed it from &lt;b&gt;3.3 V&lt;/b&gt;, the same rail as the AD8232.&lt;br&gt;&lt;br&gt;It brings its own I²C pull-ups, so no resistors.&lt;br&gt;&lt;br&gt;Screen blank? Try 0x3D (OLED_ADDR in src/main.cpp).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="875" y="630" width="235" height="140" as="geometry" /></mxCell>
        <mxCell id="w7" value="GND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#333333;endArrow=none;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eg3" target="ognd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w8" value="3.3 V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#b85450;endArrow=none;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e33c" target="ovcc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w9" value="I²C clock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#C8A200;endArrow=block;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e9" target="oscl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w10" value="I²C data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#8B5A2B;endArrow=block;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e8" target="osda"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="drv" value="&lt;b&gt;DRV8833&lt;/b&gt; &lt;span style=&#x27;font-size:10px&#x27;&gt;— unchanged&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="760" y="840" width="360" height="180" as="geometry" /></mxCell>
        <mxCell id="din1" value="IN1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="870" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="dvcc" value="VCC" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="920" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="dgnd" value="GND" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="970" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="drv_note" value="&lt;span style=&#x27;font-size:11px&#x27;&gt;IN2 → GND&lt;br&gt;OUT1 / OUT2 → motor&lt;br&gt;100 µF across VCC–GND&lt;br&gt;(striped leg to GND)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="870" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="motor" value="&lt;b&gt;Vibration motor&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;keep it and its wires ≥ 10 cm&lt;br&gt;from the AD8232 + electrode cable&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="890" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="w12" value="PWM 5 kHz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#6c8ebf;endArrow=block;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e4" target="din1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w13" value="5 V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#b85450;endArrow=none;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e5v" target="dvcc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w14" value="GND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#333333;endArrow=none;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eg2" target="dgnd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#d6b656;endArrow=none;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="drv" target="motor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el" value="&lt;b&gt;Electrode placement — 3 gel pads on the chest&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1180" y="140" width="460" height="470" as="geometry" /></mxCell>
        <mxCell id="head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b7a58c;" vertex="1" parent="1"><mxGeometry x="1375" y="185" width="70" height="44" as="geometry" /></mxCell>
        <mxCell id="torso" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b7a58c;" vertex="1" parent="1"><mxGeometry x="1290" y="225" width="240" height="290" as="geometry" /></mxCell>
        <mxCell id="pRA" value="RA" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1310" y="255" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="pLA" value="LA" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1470" y="255" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="pRL" value="RL" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1310" y="455" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="pRAt" value="wearer&#x27;s right,&lt;br&gt;below collarbone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1190" y="300" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="pLAt" value="wearer&#x27;s left,&lt;br&gt;below collarbone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1515" y="300" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="pRLt" value="wearer&#x27;s right,&lt;br&gt;lower ribs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1190" y="495" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="el_note" value="&lt;span style=&#x27;font-size:11px&#x27;&gt;Drawn &lt;b&gt;facing the wearer&lt;/b&gt;: their right is on your left. Go by the letters on the lead clips (RA / LA / RL) — cable colours differ between kits. Clean, dry skin and fresh gel pads; sit still while it reads.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1190" y="540" width="440" height="64" as="geometry" /></mxCell>
        <mxCell id="w11" value="3-lead cable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#999999;endArrow=none;endFill=1;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryY=0.8106;" edge="1" parent="1" source="jack" target="el"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oled_shows" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;What the OLED shows&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;&lt;b&gt;At boot:&lt;/b&gt; the ML self-test result, then the Wi-Fi name, password and address, and the Bluetooth name — so the demo needs no laptop.&lt;br&gt;&lt;b&gt;Then:&lt;/b&gt; the live BPM, the status (ATTACH ELECTRODES · READING… · NORMAL · DANGER!) and how many devices are paired.&lt;br&gt;The same status as the website and the app. Set &lt;b&gt;ENABLE_OLED 0&lt;/b&gt; in src/main.cpp to run without a screen.&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;align=left;spacingLeft=8;fillColor=#fff8ef;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1180" y="630" width="460" height="200" as="geometry" /></mxCell>
        <mxCell id="tab" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Wiring table — AD8232 + OLED → ESP32-S3&lt;/b&gt;&lt;br&gt;&lt;table style=&#x27;border-collapse:collapse;font-size:11px;margin-top:4px&#x27;&gt;&lt;tr&gt;&lt;th style=&#x27;border:1px solid #999;padding:3px 6px;background:#e1d5e7&#x27;&gt;#&lt;/th&gt;&lt;th style=&#x27;border:1px solid #999;padding:3px 6px;background:#e1d5e7&#x27;&gt;Module pin&lt;/th&gt;&lt;th style=&#x27;border:1px solid #999;padding:3px 6px;background:#e1d5e7&#x27;&gt;ESP32-S3 pin&lt;/th&gt;&lt;th style=&#x27;border:1px solid #999;padding:3px 6px;background:#e1d5e7&#x27;&gt;Carries&lt;/th&gt;&lt;th style=&#x27;border:1px solid #999;padding:3px 6px;background:#e1d5e7&#x27;&gt;Note&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;1&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;3.3V&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;3V3 (+ rail)&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;power&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;3.3 V only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;2&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;GND&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;G (− rail)&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;ground&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;same ground as ESP32 + DRV8833&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;3&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;OUTPUT&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;GPIO5&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;analog ECG&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;ADC1 pin: keeps working with Wi-Fi on&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;4&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;LO+&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;GPIO6&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;leads-off +&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;HIGH = an electrode is off&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;5&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;LO−&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;GPIO7&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;leads-off −&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;HIGH = an electrode is off&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;6&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;SDN&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;3V3 (+ rail)&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;enable&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;LOW would switch the chip off&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;7&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;3.5 mm jack&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;—&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;RA / LA / RL&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;3-lead snap cable to the gel pads&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;8&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;OLED GND&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;G (− rail)&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;ground&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;9&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;OLED VCC&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;3V3 (+ rail)&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;power&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;3.3 V (the module is 3.3–5 V tolerant)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;10&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;OLED SCL&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;GPIO9&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;I²C clock&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;0x3C — the only device on that bus now&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;11&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;OLED SDA&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;GPIO8&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;I²C data&lt;/td&gt;&lt;td style=&#x27;border:1px solid #999;padding:3px 6px&#x27;&gt;no pull-up resistors needed&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Motor part unchanged: GPIO4 → IN1 · IN2 → GND · 5V → VCC · GND → GND · 100 µF across VCC–GND.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="1050" width="760" height="260" as="geometry" /></mxCell>
        <mxCell id="remove" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Take out&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;• the MAX30102 and its 4 wires (VIN, GND, SDA, SCL)&lt;br&gt;• the four 10 kΩ pull-up resistors from page 5 — neither the AD8232 nor the OLED needs them&lt;br&gt;• nothing else: the OLED keeps GPIO8/GPIO9, and USB power, the rails, the DRV8833, capacitor and motor stay as they are&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="860" y="1050" width="780" height="90" as="geometry" /></mxCell>
        <mxCell id="safety" value="&lt;b style=&#x27;font-size:13px;color:#b85450&#x27;&gt;⚠ Safety&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;• Electrodes on a person &lt;b&gt;only&lt;/b&gt; while the suit runs on the power bank, or the laptop runs on battery with its charger unplugged. A charging laptop on the USB cable connects the person to a mains-derived supply.&lt;br&gt;• A heart-rate demo, not a medical device. No pads on broken or irritated skin; take them off if it itches.&lt;br&gt;• Motor noise shows up in the ECG: keep the motor and its wires away from the AD8232 and the electrode cable.&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="1160" width="780" height="130" as="geometry" /></mxCell>
        <mxCell id="serial" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;What the Serial Monitor (115200) should show&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;• boot: &lt;i&gt;SereniSuit Demo 1 booting... (ECG: AD8232)&lt;/i&gt; and the wiring line&lt;br&gt;• ML self-test: &lt;i&gt;correct: 8/8 ... matches Python: yes&lt;/i&gt;&lt;br&gt;• no pads on: &lt;i&gt;ECG: electrodes not attached&lt;/i&gt; → screens show &lt;b&gt;ATTACH ELECTRODES&lt;/b&gt;&lt;br&gt;• pads on, sitting still: &lt;i&gt;reading...&lt;/i&gt; then &lt;i&gt;BPM 72&lt;/i&gt; after 4+ beats → &lt;b&gt;NORMAL&lt;/b&gt;&lt;br&gt;• &lt;i&gt;no signal on GPIO5&lt;/i&gt; → check the OUTPUT wire and 3.3V/GND&lt;br&gt;• type &lt;b&gt;p&lt;/b&gt; → live ECG numbers for the Serial Plotter&lt;br&gt;• OLED at boot: &lt;i&gt;OLED wiring: VCC→3V3 GND→G SDA→8 SCL→9&lt;/i&gt;; if the screen is not found the line says so and everything else still runs&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="1330" width="1580" height="150" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
