      <mxCell id="d15a694" value="" style="ellipse;html=1;fillColor=#E07B00;strokeColor=none;" vertex="1" parent="61"><mxGeometry x="1458" y="694" width="11" height="11" as="geometry" /></mxCell><mxCell id="d15a239" value="" style="ellipse;html=1;fillColor=#E07B00;strokeColor=none;" vertex="1" parent="61"><mxGeometry x="1458" y="239" width="11" height="11" as="geometry" /></mxCell><mxCell id="dE48" value="" style="ellipse;html=1;fillColor=#9673a6;strokeColor=none;" vertex="1" parent="61"><mxGeometry x="1406" y="485" width="12" height="12" as="geometry" /></mxCell><mxCell id="dF45" value="" style="ellipse;html=1;fillColor=#9673a6;strokeColor=none;" vertex="1" parent="61"><mxGeometry x="1328" y="433" width="12" height="12" as="geometry" /></mxCell><mxCell id="dF46" value="" style="ellipse;html=1;fillColor=#9673a6;strokeColor=none;" vertex="1" parent="61"><mxGeometry x="1354" y="433" width="12" height="12" as="geometry" /></mxCell><mxCell id="dF47" value="" style="ellipse;html=1;fillColor=#9673a6;strokeColor=none;" vertex="1" parent="61"><mxGeometry x="1380" y="433" width="12" height="12" as="geometry" /></mxCell><mxCell id="dF48" value="" style="ellipse;html=1;fillColor=#9673a6;strokeColor=none;" vertex="1" parent="61"><mxGeometry x="1406" y="433" width="12" height="12" as="geometry" /></mxCell>
              <mxCell id="r-ad" parent="61" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;opacity=80;align=center;verticalAlign=middle;fontSize=10;" vertex="1" value="&lt;b&gt;U2 — AD8232 ECG&lt;/b&gt; row E, cols 26–31"><mxGeometry x="820" y="449" width="190" height="34" as="geometry" /></mxCell>
              <mxCell id="ad-dot-26-E" parent="61" style="ellipse;html=1;fillColor=#9673a6;strokeColor=none;" vertex="1" value=""><mxGeometry x="835.5" y="486.5" width="9" height="9" as="geometry" /></mxCell>
              <mxCell id="r-adp26" parent="61" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=8;labelBackgroundColor=#ffffff;" vertex="1" value="&lt;b&gt;GND&lt;/b&gt;"><mxGeometry x="818.0" y="500" width="44" height="14" as="geometry" /></mxCell>
              <mxCell id="ad-dot-27-E" parent="61" style="ellipse;html=1;fillColor=#9673a6;strokeColor=none;" vertex="1" value=""><mxGeometry x="861.5" y="486.5" width="9" height="9" as="geometry" /></mxCell>
              <mxCell id="r-adp27" parent="61" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=8;labelBackgroundColor=#ffffff;" vertex="1" value="&lt;b&gt;3.3V&lt;/b&gt;"><mxGeometry x="844.0" y="516" width="44" height="14" as="geometry" /></mxCell>
              <mxCell id="ad-dot-28-E" parent="61" style="ellipse;html=1;fillColor=#9673a6;strokeColor=none;" vertex="1" value=""><mxGeometry x="887.5" y="486.5" width="9" height="9" as="geometry" /></mxCell>
              <mxCell id="r-adp28" parent="61" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=8;labelBackgroundColor=#ffffff;" vertex="1" value="&lt;b&gt;OUTPUT&lt;/b&gt;"><mxGeometry x="870.0" y="500" width="44" height="14" as="geometry" /></mxCell>
              <mxCell id="ad-dot-29-E" parent="61" style="ellipse;html=1;fillColor=#9673a6;strokeColor=none;" vertex="1" value=""><mxGeometry x="913.5" y="486.5" width="9" height="9" as="geometry" /></mxCell>
              <mxCell id="r-adp29" parent="61" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=8;labelBackgroundColor=#ffffff;" vertex="1" value="&lt;b&gt;LO−&lt;/b&gt;"><mxGeometry x="896.0" y="516" width="44" height="14" as="geometry" /></mxCell>
              <mxCell id="ad-dot-30-E" parent="61" style="ellipse;html=1;fillColor=#9673a6;strokeColor=none;" vertex="1" value=""><mxGeometry x="939.5" y="486.5" width="9" height="9" as="geometry" /></mxCell>
              <mxCell id="r-adp30" parent="61" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=8;labelBackgroundColor=#ffffff;" vertex="1" value="&lt;b&gt;LO+&lt;/b&gt;"><mxGeometry x="922.0" y="500" width="44" height="14" as="geometry" /></mxCell>
              <mxCell id="ad-dot-31-E" parent="61" style="ellipse;html=1;fillColor=#9673a6;strokeColor=none;" vertex="1" value=""><mxGeometry x="965.5" y="486.5" width="9" height="9" as="geometry" /></mxCell>
              <mxCell id="r-adp31" parent="61" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=8;labelBackgroundColor=#ffffff;" vertex="1" value="&lt;b&gt;SDN&lt;/b&gt;"><mxGeometry x="948.0" y="516" width="44" height="14" as="geometry" /></mxCell>
              <mxCell id="r-adjack" parent="61" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" value="3.5 mm jack on the module → 3-lead cable → RA / LA / RL pads on the chest"><mxGeometry x="820" y="398" width="270" height="30" as="geometry" /></mxCell>
              <mxCell id="r-adorder" parent="61" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#9673a6;labelBackgroundColor=#ffffff;strokeColor=#9673a6;fillColor=#ffffff;rounded=1;dashed=1;" vertex="1" value="Check the pin order printed on &lt;i&gt;your&lt;/i&gt; AD8232&lt;br&gt;&lt;span style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;follow the silkscreen labels, not the column numbers&lt;/span&gt;"><mxGeometry x="790" y="318" width="250" height="38" as="geometry" /></mxCell>
