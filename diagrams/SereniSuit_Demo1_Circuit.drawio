        <mxCell id="t98" value="&lt;table cellpadding='5' cellspacing='0' style='border-collapse:collapse;font-size:11px;width:100%'&gt;&lt;tr style='background:#dae8fc'&gt;&lt;th align='left'&gt;Ref&lt;/th&gt;&lt;th align='left'&gt;Part&lt;/th&gt;&lt;th align='left'&gt;Value / rating&lt;/th&gt;&lt;th align='left'&gt;Where it comes from&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ESP32-S3-DevKitC-1&lt;/td&gt;&lt;td&gt;N8R8, 3.3 V logic&lt;/td&gt;&lt;td&gt;Robu&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;&lt;b&gt;U2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;MAX30102 breakout&lt;/td&gt;&lt;td&gt;I²C 0x57, 3.3 V&lt;/td&gt;&lt;td&gt;Techtonics, Amazon&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;SSD1306 OLED 0.96&amp;quot; — &lt;b style='color:#b85450'&gt;not fitted in Demo 1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;128×64, I²C 0x3C&lt;/td&gt;&lt;td&gt;Robocraze, Amazon&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;&lt;b&gt;U4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;DRV8833 dual H-bridge&lt;/td&gt;&lt;td&gt;VCC 5 V, 1.5 A/ch&lt;/td&gt;&lt;td&gt;Robu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;M1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Encapsulated vibration motor&lt;/td&gt;&lt;td&gt;3 V, 8000 RPM&lt;/td&gt;&lt;td&gt;Robu&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;&lt;b&gt;C1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Electrolytic capacitor&lt;/td&gt;&lt;td&gt;100 µF / 16 V, polarised&lt;/td&gt;&lt;td&gt;KITS4CREATORS kit&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;R1, R2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Resistors &lt;i&gt;(optional)&lt;/i&gt;&lt;/td&gt;&lt;td&gt;2 × 10 kΩ side by side each (≈ 5 kΩ), 1/4 W&lt;/td&gt;&lt;td&gt;KITS4CREATORS kit&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="110" y="2450" width="1440" height="200" as="geometry" />
        </mxCell>
              <mxCell id="wifi-badge" value="&lt;b&gt;Onboard Wi-Fi + Bluetooth LE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;802.11 b/g/n and BLE 5 radio built into the S3 module &amp;mdash; no extra part needed for either dashboard&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#0b5394;dashed=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="340" width="200" height="66" as="geometry" />
        </mxCell>
        <mxCell id="wifi-dashboard" value="&lt;b&gt;Wi-Fi + Bluetooth dashboards, paired — added&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;&lt;b&gt;Wi-Fi:&lt;/b&gt; join SereniSuit-Demo, open http://192.168.4.1 (any laptop or phone). &lt;b&gt;Bluetooth:&lt;/b&gt; the SereniSuit BT app in Chrome/Edge (laptop or Android) — no Wi-Fi to join. Every screen shows &amp;quot;Paired ✓&amp;quot; + the device list; the status shows on both screens.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#0b5394;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="1160" width="430" height="76" as="geometry" />
        </mxCell>
        <mxCell id="remote-toggle" value="&lt;b&gt;Remote sensor ON/OFF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Toggle in the website or app switches acquisition on the device on/off — both screens show SENSORS OFF to match.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#0b5394;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="1160" width="270" height="76" as="geometry" />
        </mxCell>
        <mxCell id="mobile-notify" value="&lt;b&gt;Alert after every BPM check&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;On every paired device: banner + sound + vibration while the app is open. System pop-up notifications only where the browser allows them (https).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#0b5394;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="1160" width="270" height="76" as="geometry" />
        </mxCell>
        <mxCell id="demo-fake-bpm" value="&lt;b&gt;Demo mode — fake BPM input&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Tap 72 / 45 / 140 or type any BPM in the website or app.&lt;br&gt;&lt;b&gt;Normal&lt;/b&gt; &amp;rarr; shown only. &lt;b&gt;Abnormal&lt;/b&gt; &amp;rarr; DANGER + vibration, same as a live finger.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#0b5394;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1160" width="310" height="76" as="geometry" />
        </mxCell>
<mxCell id="nf-oled" value="NOT FITTED IN DEMO 1&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;OLED removed — skip this module&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#b85450;labelBackgroundColor=#ffffff;strokeColor=#b85450;fillColor=#ffffff;rounded=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="150" y="650" width="220" height="44" as="geometry" /></mxCell>
      <mxCell id="nf-u3" value="U3 NOT FITTED IN DEMO 1&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;skip it and its 4 wires&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#b85450;labelBackgroundColor=#ffffff;strokeColor=#b85450;fillColor=#ffffff;rounded=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1070" y="1880" width="220" height="44" as="geometry" /></mxCell>
        <mxCell id="pg-circuit-old-banner" value="&lt;b&gt;OLD PAGE — MAX30102 version.&lt;/b&gt; The sensor is now the AD8232 ECG: see page 0 for the current wiring." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="-90" width="760" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg-wiring" name="2 - Wiring Table + Power Budget (old: MAX30102)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="20" />
        <mxCell id="21" parent="20" />
        <mxCell id="w-title" value="&lt;b style='font-size:20px'&gt;Pin-by-pin wiring table&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#555555'&gt;Build it in this order. Power the board OFF (USB unplugged) while wiring.&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="21">
          <mxGeometry x="110" y="30" width="1440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w-table" value="&lt;table cellpadding='5' cellspacing='0' style='border-collapse:collapse;font-size:11px;width:100%'&gt;&lt;tr style='background:#dae8fc'&gt;&lt;th align='left'&gt;#&lt;/th&gt;&lt;th align='left'&gt;From — module · pin&lt;/th&gt;&lt;th align='left'&gt;To — ESP32-S3 · pin&lt;/th&gt;&lt;th align='left'&gt;Signal&lt;/th&gt;&lt;th align='left'&gt;Value / note&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;MAX30102 · VIN&lt;/td&gt;&lt;td&gt;&lt;b&gt;3V3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Power&lt;/td&gt;&lt;td&gt;3.3 V · ~6 mA&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;MAX30102 · GND&lt;/td&gt;&lt;td&gt;&lt;b&gt;GND&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Ground&lt;/td&gt;&lt;td&gt;Common reference&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;MAX30102 · SDA&lt;/td&gt;&lt;td&gt;&lt;b&gt;GPIO8&lt;/b&gt;&lt;/td&gt;&lt;td&gt;I²C data&lt;/td&gt;&lt;td&gt;Shared bus · device 0x57&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;MAX30102 · SCL&lt;/td&gt;&lt;td&gt;&lt;b&gt;GPIO9&lt;/b&gt;&lt;/td&gt;&lt;td&gt;I²C clock&lt;/td&gt;&lt;td&gt;Shared bus&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#aaaaaa'&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;&lt;s&gt;OLED · VCC&lt;/s&gt; &lt;i&gt;— removed&lt;/i&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;3V3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Power&lt;/td&gt;&lt;td&gt;3.3 V · ~20 mA&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#aaaaaa'&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;&lt;s&gt;OLED · GND&lt;/s&gt; &lt;i&gt;— removed&lt;/i&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;GND&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Ground&lt;/td&gt;&lt;td&gt;Common reference&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#aaaaaa'&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;&lt;s&gt;OLED · SDA&lt;/s&gt; &lt;i&gt;— removed&lt;/i&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;GPIO8&lt;/b&gt;&lt;/td&gt;&lt;td&gt;I²C data&lt;/td&gt;&lt;td&gt;&lt;b&gt;Same two wires as the sensor&lt;/b&gt; · device 0x3C&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#aaaaaa'&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;&lt;s&gt;OLED · SCL&lt;/s&gt; &lt;i&gt;— removed&lt;/i&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;GPIO9&lt;/b&gt;&lt;/td&gt;&lt;td&gt;I²C clock&lt;/td&gt;&lt;td&gt;Same two wires as the sensor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;DRV8833 · VCC&lt;/td&gt;&lt;td&gt;&lt;b&gt;5V&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Motor supply&lt;/td&gt;&lt;td&gt;5 V · up to ~300 mA peak&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;DRV8833 · GND&lt;/td&gt;&lt;td&gt;&lt;b&gt;GND&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Ground&lt;/td&gt;&lt;td&gt;&lt;b&gt;Must share ground with the ESP32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;DRV8833 · IN1&lt;/td&gt;&lt;td&gt;&lt;b&gt;GPIO4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;PWM in&lt;/td&gt;&lt;td&gt;5 kHz, 8-bit, duty ≤ 60 % (≈153/255)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;DRV8833 · IN2&lt;/td&gt;&lt;td&gt;&lt;b&gt;GND&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Direction&lt;/td&gt;&lt;td&gt;Tied low — fixes one direction, fine for vibration&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;13&lt;/td&gt;&lt;td&gt;DRV8833 · SLEEP (EEP)&lt;/td&gt;&lt;td&gt;&lt;b&gt;3V3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Enable&lt;/td&gt;&lt;td&gt;&lt;b&gt;Only if your module has no onboard pull-up.&lt;/b&gt; If the motor never spins, wire this first.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;DRV8833 · OUT1&lt;/td&gt;&lt;td&gt;— motor lead 1&lt;/td&gt;&lt;td&gt;Motor out&lt;/td&gt;&lt;td&gt;≈ 3.0 V avg&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;15&lt;/td&gt;&lt;td&gt;DRV8833 · OUT2&lt;/td&gt;&lt;td&gt;— motor lead 2&lt;/td&gt;&lt;td&gt;Motor out&lt;/td&gt;&lt;td&gt;Polarity does not matter&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;100 µF cap&lt;/td&gt;&lt;td&gt;across DRV8833 VCC ↔ GND&lt;/td&gt;&lt;td&gt;Bulk decouple&lt;/td&gt;&lt;td&gt;&lt;b&gt;Striped leg (−) to GND&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;17&lt;/td&gt;&lt;td&gt;4 × 10 kΩ, in side-by-side pairs &lt;i&gt;(optional)&lt;/i&gt;&lt;/td&gt;&lt;td&gt;SDA→3V3, SCL→3V3&lt;/td&gt;&lt;td&gt;I²C pull-up&lt;/td&gt;&lt;td&gt;Fit only if the sensor is not detected&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=#6c8ebf;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="21">
          <mxGeometry x="110" y="110" width="1440" height="560" as="geometry" />
        </mxCell>
        <mxCell id="pb-title" value="&lt;b style='font-size:15px'&gt;Power budget — power bank, Wi-Fi + Bluetooth on&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="21">
          <mxGeometry x="110" y="700" width="600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="pb-table" value="&lt;table cellpadding='5' cellspacing='0' style='border-collapse:collapse;font-size:11px;width:100%'&gt;&lt;tr style='background:#d5e8d4'&gt;&lt;th align='left'&gt;Load&lt;/th&gt;&lt;th align='left'&gt;Rail&lt;/th&gt;&lt;th align='left'&gt;Typical&lt;/th&gt;&lt;th align='left'&gt;Peak&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ESP32-S3, own Wi-Fi network + Bluetooth LE on&lt;/td&gt;&lt;td&gt;5 V → onboard LDO&lt;/td&gt;&lt;td&gt;~110–140 mA&lt;/td&gt;&lt;td&gt;~350 mA TX burst&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;MAX30102&lt;/td&gt;&lt;td&gt;3V3&lt;/td&gt;&lt;td&gt;~6 mA&lt;/td&gt;&lt;td&gt;~20 mA&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#aaaaaa'&gt;&lt;td&gt;&lt;s&gt;SSD1306 OLED&lt;/s&gt; &lt;i&gt;— removed&lt;/i&gt;&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;0 mA&lt;/td&gt;&lt;td&gt;0 mA&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;Vibration motor @ 60 % duty&lt;/td&gt;&lt;td&gt;5 V via DRV8833&lt;/td&gt;&lt;td&gt;~55 mA avg&lt;/td&gt;&lt;td&gt;~250 mA inrush&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DRV8833 quiescent&lt;/td&gt;&lt;td&gt;5 V&lt;/td&gt;&lt;td&gt;~2 mA&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#dae8fc'&gt;&lt;td&gt;&lt;b&gt;TOTAL&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;USB-C 5 V&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;~170 mA&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;~650 mA (brief)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#d5e8d4'&gt;&lt;td colspan='4'&gt;&lt;b&gt;Power bank ≥ 1 A → comfortable headroom.&lt;/b&gt; A 500 mA laptop port is too tight once Wi-Fi and the motor peak together, so use the laptop only to flash. ~170 mA idle keeps most power banks from auto-switching off — test yours for 10 minutes before the review.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=#82b366;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="21">
          <mxGeometry x="110" y="730" width="700" height="270" as="geometry" />
        </mxCell>
        <mxCell id="oled-note" value="&lt;b style='font-size:13px;color:#b85450'&gt;Not needed now — the OLED is removed from Demo 1.&lt;/b&gt;&lt;br&gt;&lt;b style='font-size:13px'&gt;If your OLED turns out to be the 7-pin SPI version&lt;/b&gt;&lt;hr&gt;&lt;span style='font-size:11px'&gt;The Robocraze board is sold as &quot;SPI/I²C&quot;. Count the header pins first:&lt;br&gt;&lt;br&gt;&lt;b&gt;4 pins&lt;/b&gt; (GND · VCC · SCL · SDA) → I²C. Wire exactly as the table above. &lt;b&gt;Most likely case.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;7 pins&lt;/b&gt; (GND · VCC · D0 · D1 · RES · DC · CS) → SPI by default:&lt;br&gt;&amp;nbsp;&amp;nbsp;D0 (SCK) → GPIO12&lt;br&gt;&amp;nbsp;&amp;nbsp;D1 (MOSI) → GPIO11&lt;br&gt;&amp;nbsp;&amp;nbsp;RES → GPIO13&lt;br&gt;&amp;nbsp;&amp;nbsp;DC → GPIO14&lt;br&gt;&amp;nbsp;&amp;nbsp;CS → GPIO10&lt;br&gt;&amp;nbsp;&amp;nbsp;VCC → 3V3 · GND → GND&lt;br&gt;and switch the sketch to the SPI constructor of Adafruit_SSD1306.&lt;br&gt;&lt;br&gt;&lt;i&gt;Check this tonight, not on review morning — it changes five wires.&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;opacity=45;" vertex="1" parent="21">
          <mxGeometry x="850" y="730" width="700" height="250" as="geometry" />
        </mxCell>
        <mxCell id="bb-note" value="&lt;b style='font-size:13px'&gt;Breadboard layout tips (MB102)&lt;/b&gt;&lt;hr&gt;&lt;span style='font-size:11px'&gt;• Put the ESP32-S3 DevKit across the centre channel. On the MB102 it is wide — you may only get one free hole per pin, so use the outer row and male-to-female jumpers for the modules.&lt;br&gt;• Run &lt;b&gt;one&lt;/b&gt; red wire to the + rail from 3V3 and keep 5 V off the rails entirely — take 5 V on a single dedicated jumper straight to DRV8833 VCC. This prevents the classic accident of a 3.3 V sensor landing on a 5 V rail.&lt;br&gt;• Tie both blue (−) rails together and run one wire to an ESP32 GND. Every module ground goes to that rail.&lt;br&gt;• &lt;b&gt;Tape or clamp the vibration motor to the bench, at least 10 cm from the MAX30102.&lt;/b&gt; If the motor shakes the sensor, the PPG signal collapses and the BPM reading jumps the instant your alert fires — the single most likely way this demo embarrasses you in front of the panel.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="21">
          <mxGeometry x="110" y="1010" width="1440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="pg-wiring-old-banner" value="&lt;b&gt;OLD PAGE — MAX30102 version.&lt;/b&gt; The sensor is now the AD8232 ECG: see page 0 for the current wiring." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="21"><mxGeometry x="40" y="-90" width="760" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg-safety" name="3 - Safety + Measurement Checks">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="40" />
        <mxCell id="41" parent="40" />
        <mxCell id="s-title" value="&lt;b style='font-size:20px'&gt;Safety rules and measurement checks&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#555555'&gt;Work through the left column before you plug in, and the right column with a multimeter once you do.&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="41">
          <mxGeometry x="110" y="30" width="1440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s-rules" value="&lt;b style='font-size:14px'&gt;Safety rules — and the reason behind each&lt;/b&gt;&lt;hr&gt;&lt;table cellpadding='4' cellspacing='0' style='border-collapse:collapse;font-size:11px;width:100%'&gt;&lt;tr style='background:#f8cecc'&gt;&lt;th align='left' width='20'&gt;#&lt;/th&gt;&lt;th align='left'&gt;Rule&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;&lt;b&gt;Never drive the motor straight off a GPIO.&lt;/b&gt; It draws 80–250 mA against a 40 mA absolute limit, and the collapsing coil field kicks a reverse spike back into the pin. Always through the DRV8833.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;&lt;b&gt;Keep PWM duty at or below 60 % on the 5 V rail.&lt;/b&gt; The motor is a 3 V part; 5 V continuous overdrives it, runs it hot and shortens its life.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;&lt;b&gt;Electrolytic capacitor polarity.&lt;/b&gt; The striped leg is negative and goes to GND. Backwards, it heats up and can vent or burst.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;&lt;b&gt;One common ground.&lt;/b&gt; Every module GND must reach the ESP32 GND. A floating ground makes I²C read garbage and the driver behave unpredictably.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;&lt;b&gt;3.3 V only for the sensor.&lt;/b&gt; Do not land them on the 5 V rail unless the module is explicitly marked 5 V tolerant.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;&lt;b&gt;Never connect the LiPo directly to the 3V3 rail.&lt;/b&gt; A charged cell sits at 3.7–4.2 V and will damage 3.3 V parts. For Phase 3 the chain is LiPo → TP4056 → regulator → 3V3.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;&lt;b&gt;Never charge and use the LiPo unattended&lt;/b&gt;, and never leave the TP4056 charging on fabric or foam. Not used in Demo 1 — keep it that way.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;&lt;b&gt;ECG safety, for later phases.&lt;/b&gt; Never attach AD8232 electrodes to a person while the board is powered from a mains-connected charger. Run the laptop on battery, or the board on its own battery. Not part of Demo 1.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;&lt;b&gt;Body contact is limited to a fingertip on the optical window.&lt;/b&gt; The MAX30102 is a Class 1 LED device and passes no current into the body — this is the honest answer if the panel asks about subject safety.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;&lt;b&gt;Power down before rewiring.&lt;/b&gt; Hot-plugging a breadboard is how shorts and dead boards happen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;&lt;b&gt;Keep the motor mechanically away from the sensor.&lt;/b&gt; Not an electrical hazard but a demo-killer: vibration coupling into the MAX30102 destroys the PPG signal exactly when the alert fires.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;&lt;b&gt;State the scope out loud.&lt;/b&gt; This reads heart rate from PPG. It is not blood pressure, and it is not a diagnostic device. Saying so first is stronger than being corrected.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="41">
          <mxGeometry x="110" y="110" width="700" height="620" as="geometry" />
        </mxCell>
        <mxCell id="s-meas" value="&lt;b style='font-size:14px'&gt;Multimeter checks — measure, do not assume&lt;/b&gt;&lt;hr&gt;&lt;table cellpadding='4' cellspacing='0' style='border-collapse:collapse;font-size:11px;width:100%'&gt;&lt;tr style='background:#dae8fc'&gt;&lt;th align='left' width='20'&gt;#&lt;/th&gt;&lt;th align='left'&gt;Measure&lt;/th&gt;&lt;th align='left'&gt;Expected&lt;/th&gt;&lt;th align='left'&gt;If wrong&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;3V3 pin ↔ GND, DC&lt;/td&gt;&lt;td&gt;&lt;b&gt;3.25 – 3.35 V&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Unplug at once — likely a short on the rail&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;5V pin ↔ GND, DC&lt;/td&gt;&lt;td&gt;&lt;b&gt;4.75 – 5.10 V&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Weak cable, port or power bank — try another USB-C lead&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;Continuity: each module GND ↔ ESP32 GND&lt;/td&gt;&lt;td&gt;&lt;b&gt;beeps, &amp;lt; 1 Ω&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Reseat the breadboard ground rail jumper&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;SDA ↔ GND with bus idle, DC&lt;/td&gt;&lt;td&gt;&lt;b&gt;3.1 – 3.3 V&lt;/b&gt;&lt;/td&gt;&lt;td&gt;If it reads ~1.8 V, fit the pull-ups (two 10 kΩ side by side per line, page 5) to 3V3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;DRV8833 VCC ↔ GND, DC&lt;/td&gt;&lt;td&gt;&lt;b&gt;4.75 – 5.10 V&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Check the dedicated 5 V jumper&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;OUT1 ↔ OUT2 while DANGER is active, DC&lt;/td&gt;&lt;td&gt;&lt;b&gt;2.7 – 3.2 V avg&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Above 3.3 V → lower the PWM duty in the sketch&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;Total draw, USB inline meter&lt;/td&gt;&lt;td&gt;&lt;b&gt;~160 – 210 mA idle&lt;/b&gt; (Wi-Fi + Bluetooth on)&lt;/td&gt;&lt;td&gt;Over ~400 mA with the motor off means a short — disconnect&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;I²C scan sketch, Serial @ 115200&lt;/td&gt;&lt;td&gt;&lt;b&gt;finds 0x57&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Missing 0x57 → check VIN and GND first, then the pull-ups (page 5)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b style='font-size:13px'&gt;Run an I²C scanner first.&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;The demo firmware runs this scan itself at start-up and every 3 s on the Serial Monitor. If it does not print 0x57, nothing else is worth debugging yet. This one step saves the most time.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="41">
          <mxGeometry x="850" y="110" width="700" height="480" as="geometry" />
        </mxCell>
        <mxCell id="s-check" value="&lt;b style='font-size:14px'&gt;Pre-power-on checklist&lt;/b&gt;&lt;hr&gt;&lt;span style='font-size:12px'&gt;☐&amp;nbsp; Nothing bridges the 5 V and 3V3 rails&lt;br&gt;☐&amp;nbsp; Capacitor stripe (−) sits on the GND rail&lt;br&gt;☐&amp;nbsp; No 3.3 V module is fed from 5 V&lt;br&gt;☐&amp;nbsp; Motor leads are on OUT1/OUT2, not on any GPIO&lt;br&gt;☐&amp;nbsp; Motor is taped down, ≥ 10 cm from the sensor&lt;br&gt;☐&amp;nbsp; AD8232 and its electrodes are not connected to anyone&lt;br&gt;☐&amp;nbsp; Board was unplugged for the whole wiring session&lt;br&gt;☐&amp;nbsp; One last visual sweep for stray strands bridging rows&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="41">
          <mxGeometry x="850" y="610" width="700" height="250" as="geometry" />
        </mxCell>
        <mxCell id="s-parts" value="&lt;b style='font-size:14px'&gt;What you already own — used in Demo 1 vs. kept for later&lt;/b&gt;&lt;hr&gt;&lt;table cellpadding='5' cellspacing='0' style='border-collapse:collapse;font-size:11px;width:100%'&gt;&lt;tr style='background:#d5e8d4'&gt;&lt;th align='left' colspan='2'&gt;USE FOR DEMO 1&lt;/th&gt;&lt;th align='left' colspan='2' style='background:#f8cecc'&gt;LEAVE BOXED — later phases&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width='26%'&gt;ESP32-S3-DevKitC-1-N8R8&lt;/td&gt;&lt;td width='24%'&gt;&lt;i&gt;Robu, ₹1619&lt;/i&gt;&lt;/td&gt;&lt;td width='26%'&gt;AD8232 ECG module&lt;/td&gt;&lt;td width='24%'&gt;&lt;i&gt;Phase 1 full / Phase 2&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;MAX30102 pulse sensor&lt;/td&gt;&lt;td&gt;&lt;i&gt;Techtonics, Amazon&lt;/i&gt;&lt;/td&gt;&lt;td&gt;Seeed Grove GSR sensor&lt;/td&gt;&lt;td&gt;&lt;i&gt;Phase 2 — arousal&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0.96&amp;quot; OLED 128×64 &lt;i&gt;(not used in Demo 1)&lt;/i&gt;&lt;/td&gt;&lt;td&gt;&lt;i&gt;Robocraze, Amazon&lt;/i&gt;&lt;/td&gt;&lt;td&gt;MPU-6050 IMU&lt;/td&gt;&lt;td&gt;&lt;i&gt;Phase 2 — motion artifact&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;DRV8833 motor driver&lt;/td&gt;&lt;td&gt;&lt;i&gt;Robu, ₹51&lt;/i&gt;&lt;/td&gt;&lt;td&gt;REES52 flex bend sensor&lt;/td&gt;&lt;td&gt;&lt;i&gt;Phase 2 — respiration&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Vibration motor × 1&lt;/td&gt;&lt;td&gt;&lt;i&gt;Robu encapsulated&lt;/i&gt;&lt;/td&gt;&lt;td&gt;LiPo 1500 mAh + TP4056&lt;/td&gt;&lt;td&gt;&lt;i&gt;Phase 3 — USB is safer now&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;MB102 breadboard&lt;/td&gt;&lt;td&gt;&lt;i&gt;Robu, ₹57&lt;/i&gt;&lt;/td&gt;&lt;td&gt;MicroSD card reader&lt;/td&gt;&lt;td&gt;&lt;i&gt;Phase 2/3 — logging&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Jumper wires M-M, M-F, F-F&lt;/td&gt;&lt;td&gt;&lt;i&gt;Robu&lt;/i&gt;&lt;/td&gt;&lt;td&gt;Soldering kit, heat shrink, JST, velcro, enclosure&lt;/td&gt;&lt;td&gt;&lt;i&gt;Phase 3 — wearable build&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8f8f8'&gt;&lt;td&gt;100 µF cap + 4 × 10 kΩ&lt;/td&gt;&lt;td&gt;&lt;i&gt;KITS4CREATORS kit&lt;/i&gt;&lt;/td&gt;&lt;td&gt;&lt;b style='color:#b85450'&gt;Compression vest — you refunded it&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;i&gt;Re-order before Phase 3&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;USB-C cable&lt;/td&gt;&lt;td&gt;&lt;i&gt;power + flashing&lt;/i&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="41">
          <mxGeometry x="110" y="950" width="1440" height="380" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
