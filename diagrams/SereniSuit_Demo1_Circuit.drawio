        <mxCell id="r893" parent="61" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" value="&lt;b style='color:#ffffff'&gt;+&lt;/b&gt;" vertex="1">
          <mxGeometry height="16" width="30" x="1215" y="636" as="geometry" />
        </mxCell>
