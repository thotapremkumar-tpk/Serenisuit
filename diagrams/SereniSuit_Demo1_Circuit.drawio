        <mxCell id="p5-180" value="" style="ellipse;html=1;fillColor=#6b6b6b;strokeColor=#6b6b6b;" vertex="1" parent="1"><mxGeometry x="1311.0" y="476.0" width="8.0" height="8.0" as="geometry" /></mxCell>
        <mxCell id="p5-181" value="" style="ellipse;html=1;fillColor=#6b6b6b;strokeColor=#6b6b6b;" vertex="1" parent="1"><mxGeometry x="1386.0" y="576.0" width="8.0" height="8.0" as="geometry" /></mxCell>
        <mxCell id="p5-182" value="" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#e6c79c;strokeColor=#9b7446;rotation=53.1;" vertex="1" parent="1"><mxGeometry x="1317.5" y="520.0" width="70.0" height="20.0" as="geometry" /></mxCell>
        <mxCell id="p5-183" value="" style="rounded=0;html=1;fillColor=#7B4A12;strokeColor=none;rotation=53.1;" vertex="1" parent="1"><mxGeometry x="1336.3" y="502.4" width="6.0" height="20.0" as="geometry" /></mxCell>
        <mxCell id="p5-184" value="" style="rounded=0;html=1;fillColor=#1a1a1a;strokeColor=none;rotation=53.1;" vertex="1" parent="1"><mxGeometry x="1342.3" y="510.4" width="6.0" height="20.0" as="geometry" /></mxCell>
        <mxCell id="p5-185" value="" style="rounded=0;html=1;fillColor=#F08A00;strokeColor=none;rotation=53.1;" vertex="1" parent="1"><mxGeometry x="1348.3" y="518.4" width="6.0" height="20.0" as="geometry" /></mxCell>
        <mxCell id="p5-186" value="" style="rounded=0;html=1;fillColor=#C9A227;strokeColor=none;rotation=53.1;" vertex="1" parent="1"><mxGeometry x="1362.7" y="537.6" width="6.0" height="20.0" as="geometry" /></mxCell>
        <mxCell id="p5-187" value="&lt;b style=&#x27;color:#2E8B2E&#x27;&gt;SCL pair&lt;/b&gt; (2 × 10 kΩ)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="1045.0" y="612.0" width="245.0" height="20.0" as="geometry" /></mxCell>
        <mxCell id="p5-188" value="&lt;b style=&#x27;color:#1F6FD0&#x27;&gt;SDA pair&lt;/b&gt; (2 × 10 kΩ)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="1290.0" y="612.0" width="245.0" height="20.0" as="geometry" /></mxCell>
        <mxCell id="p5-189" value="&lt;span style=&#x27;color:#2E8B2E&#x27;&gt;■&lt;/span&gt;&lt;span style=&#x27;color:#1F6FD0&#x27;&gt;■&lt;/span&gt; your existing wires to ESP32 &lt;b&gt;pin 9&lt;/b&gt; (SCL) and &lt;b&gt;pin 8&lt;/b&gt; (SDA) — leave them as they are&lt;br&gt;◯ holes where a resistor leg goes · shaded column = the 5 holes (f–j) joined inside the breadboard&lt;br&gt;Each pair: &lt;b&gt;one leg of both&lt;/b&gt; in the same column, &lt;b&gt;the other leg of both&lt;/b&gt; in the &lt;b&gt;+ rail (3.3 V)&lt;/b&gt;. The legs pass &lt;i&gt;over&lt;/i&gt; the − rail — never into it.&lt;br&gt;&lt;i&gt;Your MAX30102&#x27;s pin order may differ from this picture — use whichever columns your SDA and SCL pins are in.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="880.0" y="640.0" width="760.0" height="116.0" as="geometry" /></mxCell>
        <mxCell id="p5-190" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5fbf2;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40.0" y="790.0" width="1100.0" height="290.0" as="geometry" /></mxCell>
        <mxCell id="p5-191" value="&lt;b&gt;③ Step by step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;spacing=2;" vertex="1" parent="1"><mxGeometry x="60.0" y="802.0" width="1060.0" height="28.0" as="geometry" /></mxCell>
        <mxCell id="p5-192" value="&lt;ol style='margin:0;padding-left:20px;line-height:1.45'&gt;&lt;li&gt;&lt;b&gt;Unplug&lt;/b&gt; the ESP32 (USB or power bank) before touching the board.&lt;/li&gt;&lt;li&gt;Pick &lt;b&gt;4 resistors&lt;/b&gt; with the bands &lt;b&gt;brown – black – orange&lt;/b&gt; (10 kΩ).&lt;/li&gt;&lt;li&gt;&lt;b&gt;SDA:&lt;/b&gt; push one leg of resistor 1 into a free hole in the &lt;b&gt;MAX30102 SDA column&lt;/b&gt;, the other leg into the &lt;b&gt;+ rail that carries 3.3 V&lt;/b&gt;. Do the same with resistor 2, using &lt;i&gt;another&lt;/i&gt; free hole in the same column and &lt;i&gt;another&lt;/i&gt; hole in the same + rail.&lt;/li&gt;&lt;li&gt;&lt;b&gt;SCL:&lt;/b&gt; repeat with resistors 3 and 4 in the &lt;b&gt;MAX30102 SCL column&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Check before power:&lt;/b&gt; no leg in the − rail · the SDA pair doesn't touch the SCL pair · the + rail you used is the 3.3 V one (the rail feeding MAX30102 VIN), &lt;b&gt;not 5 V&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Power on:&lt;/b&gt; the Serial Monitor should say &lt;b&gt;“I2C check: MAX30102 OK”&lt;/b&gt;. With a meter, SDA to GND reads about &lt;b&gt;3.1–3.3 V&lt;/b&gt; when idle.&lt;/li&gt;&lt;/ol&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="60.0" y="836.0" width="1060.0" height="236.0" as="geometry" /></mxCell>
        <mxCell id="p5-193" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1160.0" y="790.0" width="500.0" height="290.0" as="geometry" /></mxCell>
        <mxCell id="p5-194" value="&lt;b&gt;Which resistor is 10 kΩ?&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;spacing=2;" vertex="1" parent="1"><mxGeometry x="1180.0" y="802.0" width="460.0" height="28.0" as="geometry" /></mxCell>
        <mxCell id="p5-195" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;strokeColor=#8d8d8d;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215.0" y="880.0" as="sourcePoint" /><mxPoint x="1605.0" y="880.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p5-196" value="" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#e6c79c;strokeColor=#9b7446;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1300.0" y="856.0" width="220.0" height="48.0" as="geometry" /></mxCell>
        <mxCell id="p5-197" value="" style="rounded=0;html=1;fillColor=#7B4A12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1330.0" y="856.0" width="16.0" height="48.0" as="geometry" /></mxCell>
        <mxCell id="p5-198" value="" style="rounded=0;html=1;fillColor=#1a1a1a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1362.0" y="856.0" width="16.0" height="48.0" as="geometry" /></mxCell>
        <mxCell id="p5-199" value="" style="rounded=0;html=1;fillColor=#F08A00;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1394.0" y="856.0" width="16.0" height="48.0" as="geometry" /></mxCell>
        <mxCell id="p5-200" value="" style="rounded=0;html=1;fillColor=#C9A227;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1480.0" y="856.0" width="16.0" height="48.0" as="geometry" /></mxCell>
        <mxCell id="p5-201" value="brown&lt;br&gt;&lt;b&gt;1&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="1302.0" y="910.0" width="72.0" height="36.0" as="geometry" /></mxCell>
        <mxCell id="p5-202" value="black&lt;br&gt;&lt;b&gt;0&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="1334.0" y="910.0" width="72.0" height="36.0" as="geometry" /></mxCell>
        <mxCell id="p5-203" value="orange&lt;br&gt;&lt;b&gt;× 1000&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="1366.0" y="910.0" width="72.0" height="36.0" as="geometry" /></mxCell>
        <mxCell id="p5-204" value="gold&lt;br&gt;&lt;b&gt;± 5 %&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="1452.0" y="910.0" width="72.0" height="36.0" as="geometry" /></mxCell>
        <mxCell id="p5-205" value="&lt;b&gt;1 · 0 · × 1000 = 10 000 Ω = 10 kΩ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="1180.0" y="952.0" width="460.0" height="24.0" as="geometry" /></mxCell>
        <mxCell id="p5-206" value="&lt;b style=&#x27;color:#b85450&#x27;&gt;Don&#x27;t use the others in the kit:&lt;/b&gt;&lt;br&gt;brown – black – &lt;b&gt;red&lt;/b&gt; = 1 kΩ (too strong)&lt;br&gt;brown – black – &lt;b&gt;yellow&lt;/b&gt; = 100 kΩ (too weak)&lt;br&gt;red – red – brown = 220 Ω · brown – black – brown = 100 Ω&lt;br&gt;&lt;i&gt;Read the bands from the end that is &lt;b&gt;not&lt;/b&gt; gold.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="1180.0" y="982.0" width="460.0" height="92.0" as="geometry" /></mxCell>
        <mxCell id="pg-pullups-old-banner" value="&lt;b&gt;OLD PAGE — MAX30102 version.&lt;/b&gt; The sensor is now the AD8232 ECG: see page 0 for the current wiring." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="-90" width="760" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>